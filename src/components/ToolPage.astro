---
/** Page outil (RECETTE §9) : le calculateur est le contenu principal, 500 à 700 mots autour, `data-outil`. */
import PageLayout from '../layouts/PageLayout.astro';
import AdSlot from './AdSlot.astro';
import { route, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { webApplicationSchema, faqSchema, breadcrumbSchema, webPageSchema, type FAQItem } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import { fitDescription, fitTitle } from '../lib/snippet';
interface Props { lang: Locale; id: string; title: string; h1: string; description: string; intro: string; resume: string; faqs: FAQItem[]; related: string[]; sources: Array<{ name: string; url: string }> }
const { lang, id, title: rawTitle, h1, description: rawDesc, intro, resume, faqs, related, sources } = Astro.props;
const ui = t(lang);
const title = fitTitle(rawTitle, lang); const description = fitDescription(rawDesc, lang);
const path = route(id, lang);
const jsonLd = [webApplicationSchema({ name: h1, description, path, lang }), webPageSchema({ name: h1, description, path, lang }), faqSchema(faqs, lang), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: label(id, lang), path }])];
const rel = related.map((r) => ({ href: route(r, lang), name: label(r, lang), description: '' }));
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={rel} sources={sources} breadcrumbs={[{ label: label(id, lang) }]}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{h1}</h1>
    <p class="mt-3 text-lg text-navy-600">{intro}</p>
    <p class="mt-2 text-sm text-navy-500">{ui.reviewedBy} <a href={route('about', lang)} class="text-accent-700 hover:underline">{AUTHOR_NAME}</a></p>
  </header>
  <div data-outil>
    <slot name="tool" />
  </div>
  <p class="mt-8 text-navy-700">{resume}</p>
  <AdSlot slot={`${id}-1`} />
  <section class="prose prose-slate mt-10 max-w-none"><slot /></section>
</PageLayout>
