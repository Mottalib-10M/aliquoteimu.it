---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/calcolo-imu/?lang=en" title="Italian IMU calculator with each comune's rates" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Italian IMU Calculator on Your Website for Free" description="Add the Italian IMU property tax calculator, with every comune’s official rates, to your website for free with one iframe: no sign-up, no tracking, data kept current by us." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the IMU calculator on your site</h1>
    <p class="mt-3 text-lg text-navy-600">One line of code, no sign-up, no fee. Estate agents, relocation services, expat forums and lawyers can offer their readers the Italian property tax calculation with each comune’s official rates.</p></header>
  <div class="prose prose-slate max-w-none">
    <p>Paste this code where the calculator should appear. The height does not adjust automatically: 1,100 pixels suit a desktop layout; allow about 1,600 pixels in a narrow column. Remove <code>?lang=en</code> for the Italian version.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: the link to aliquoteimu.it under the calculator must stay visible, and the widget must not be altered. It is provided without guarantee of availability or result. Rates are updated on this site, so your embed stays current.</p>
    <p>No data from your visitors reaches us: the calculation runs in their browser and the iframe sets no tracking or advertising cookie. For another size or a question, use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/calcolo-imu/?lang=en" title="Italian IMU calculator with each comune's rates" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
